					PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					ChangedType = Table.TransformColumnTypes(PromotedHeaders, {{"provinsi_id", Int64.Type}, {"provinsi", type text}, {"tahun_id", Int64.Type}, {"uhh_tahun", type number}, {"hls_tahun", type number}, {"rls_tahun", type number}, {"pengeluaran_ribu_rp", Int64.Type}, {"ipm", type number}, {"kategori", type text}, {"pertumbuhan_persen", type number}})
